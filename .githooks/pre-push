#!/bin/sh
# Refuse a push whose docs have drifted from the code.
#
# Shiplock is the gate: declared docs present, banned words, version
# alignment, the architecture doc's module list against ripple/, the
# per-file manifest against the shipped sources, one declaration per
# dependency, an expectation in every test, and README link hygiene. Ruff
# runs first because a lint failure is cheaper to read than a docs report.
#
# The suite runs the same Shiplock gate in tests/test_docs.py, so this is
# the last line rather than the only one. Set RIPPLE_PREPUSH_TESTS=1 to run
# the whole suite here too. An emergency push goes through with
# `git push --no-verify`.
set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

# Branch protection for main, run before the slower gates so a refused push
# fails at once. GitHub's own protection needs a paid plan on a private
# repository, so this stands in for it: main takes no deletion and no
# rewrite of history it already has. Local, so `--no-verify` goes round it;
# it guards against the slip, not against intent.
protected=refs/heads/main
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "$protected" ] || continue

  case "$local_sha" in
    *[!0]*) ;;
    *)
      echo "pre-push: refusing to delete main." >&2
      exit 1
      ;;
  esac

  # An all-zero remote sha is the branch's first push: nothing to rewrite.
  case "$remote_sha" in *[!0]*) ;; *) continue ;; esac

  if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    echo "pre-push: main is at a commit this clone does not have." >&2
    echo "  Run 'git fetch' and look at what is there before pushing." >&2
    exit 1
  fi

  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "pre-push: refusing to rewrite pushed history on main." >&2
    echo "  ${remote_sha} is not an ancestor of what you are pushing, so" >&2
    echo "  commits already on the remote would go. Rebase onto origin/main," >&2
    echo "  or push a branch instead." >&2
    exit 1
  fi
done

if [ ! -x .venv/bin/shiplock ]; then
  echo "pre-push: no .venv/bin/shiplock. Run:" >&2
  echo "  python3 -m venv .venv && .venv/bin/pip install -e \".[dev]\"" >&2
  exit 1
fi

echo "pre-push: ruff"
.venv/bin/ruff check ripple/ tests/ tools/

echo "pre-push: shiplock"
.venv/bin/shiplock check

# Shiplock is a released package, so the repo's own rules run beside it.
# This one caps any changelog entry this branch adds: the detail belongs in
# the entry's first sentences or not at all.
echo "pre-push: changelog"
python3 tools/check_changelog.py

if [ "${RIPPLE_PREPUSH_TESTS:-0}" = "1" ]; then
  echo "pre-push: pytest"
  .venv/bin/python -m pytest -q
fi

echo "pre-push: clean"
