#!/bin/sh
# Refuse any commit whose message carries an attribution trailer.
#
# The repository sets core.hooksPath to .githooks so the push gate travels
# with it, which takes this repo out of any global hooks directory. This
# keeps that guard in force here, and widens it: a co-author trailer, a
# generated-by line, or a tool's noreply address all name something other
# than the person committing, and none of them belong in the history.
if grep -qiE '^[[:space:]]*co-authored-by:' "$1"; then
  echo "commit refused: co-author trailer in the message" >&2
  exit 1
fi
if grep -qiE '^[[:space:]]*(generated with|🤖 generated)' "$1"; then
  echo "commit refused: generated-by line in the message" >&2
  exit 1
fi
if grep -qiE 'noreply@anthropic\.com' "$1"; then
  echo "commit refused: tool attribution address in the message" >&2
  exit 1
fi

# The banned-word list governs commit messages too: shiplock's built-ins
# plus this repo's extra_banned. Literal shape words are exempt, matching
# the shiplock.toml note; the verb tic is caught by "shapes".
BANNED='travel|matters|serious|intersection|quietly|exactly|genuine|genuinely|consistently|straightforward|worth|earn|earns|sits|sat|lands|landed|shapes|actually|land|shifts|gap|gaps|sharper|cleanly|real|mattered|clean|clear|stayed|simple|plainly'
hit=$(grep -oiwE "$BANNED" "$1" | head -1)
if [ -n "$hit" ]; then
  echo "commit refused: banned word '$hit' in the message" >&2
  exit 1
fi
